# Copy to .env and change the secrets. `docker compose up --build` also works
# without a .env file, using the development defaults in docker-compose.yml.
# Never commit a real .env.

# MySQL root password. Only used by the MySQL container itself (init + healthcheck).
MYSQL_ROOT_PASSWORD=change-me-root-password

# Least-privilege MySQL user the Python API connects as (SELECT/INSERT/UPDATE/DELETE on EZPoll only).
# Also the account to use when logging in to phpMyAdmin.
EZPOLL_DB_USER=ezpoll_app
EZPOLL_DB_PASSWORD=change-me-app-password

# Shared secret the socket server sends to the Python API (X-Internal-Secret header).
# Generate one with: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-internal-secret

# Browser origin(s) of the client, comma separated. Used for CORS on the API and socket server.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Browser-facing origin of the socket server. Written to the client's config.json and its CSP connect-src.
PUBLIC_SOCKET_URL=http://localhost:3000

# Host ports (client, socket server, API/MySQL/phpMyAdmin are bound to 127.0.0.1 only)
CLIENT_PORT=8080
SOCKET_PORT=3000
API_PORT=5000
MYSQL_PORT=3307
PHPMYADMIN_PORT=8083
